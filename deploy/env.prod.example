# ==========================================================================
# Production environment for the AWS EC2 server.
#
# On the server, copy this file to "env.prod" and fill in the real values:
#     cp env.prod.example env.prod
#     nano env.prod
#
# NEVER commit env.prod (with real secrets) to git. Only this .example is safe.
# ==========================================================================

# The public domain that points at your EC2 instance (no https://, no slash).
# Use your free DuckDNS subdomain, e.g. docmind-demo.duckdns.org
DOMAIN=your-subdomain.duckdns.org

# Your Cloudflare Pages frontend URL (used for CORS). No trailing slash.
# e.g. https://docmind.pages.dev  (or your custom domain)
FRONTEND_URL=https://your-app.pages.dev

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# A long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
